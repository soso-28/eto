import sys

ETO = ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]

count = 0
for line in sys.stdin:
    s = line.strip()
    if s == "":
        continue

    try:
        year = int(s.split("-")[0])
    except ValueError:
        print("年または生年月日を入力してください", file=sys.stderr)
        sys.exit(1)

    if year < 1:
        print("1以上の西暦を入力してください", file=sys.stderr)
        sys.exit(1)

    print(ETO[(year - 4) % 12])
    count += 1

if count == 0:
    print("入力がありません", file=sys.stderr)
    sys.exit(1)
