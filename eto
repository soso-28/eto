import argparse
import sys

ETO = ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]
YOMI = ["ね", "うし", "とら", "う", "たつ", "み", "うま", "ひつじ", "さる", "とり", "いぬ", "い"]

parser = argparse.ArgumentParser(description="西暦または生年月日から干支を出力するコマンド")
parser.add_argument("-y", "--yomi", action="store_true", help="干支を読み仮名（ひらがな）で出力する")
args = parser.parse_args()

count = 0
for line in sys.stdin:
    s = line.strip()
    if s == "":
        continue

    try:
        year = int(s.split("-")[0])
    except ValueError:
        print("年または生年月日を入力してください", file=sys.stderr)
        sys.exit(1)

    if year < 1:
        print("1以上の西暦を入力してください", file=sys.stderr)
        sys.exit(1)

    idx = (year - 4) % 12
    print(YOMI[idx] if args.yomi else ETO[idx])
    count += 1

if count == 0:
    print("入力がありません", file=sys.stderr)
    sys.exit(1)
